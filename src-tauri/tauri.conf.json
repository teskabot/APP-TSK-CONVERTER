{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Conversor",
  "version": "0.1.0",
  "identifier": "app.conversor.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Conversor",
        "width": 880,
        "height": 640,
        "minWidth": 640,
        "minHeight": 520,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/ffmpeg",
      "binaries/ffprobe"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "resources": {
      "../AVISOS-DE-TERCEROS.md": "AVISOS-DE-TERCEROS.md",
      "../licencias/*": "licencias/"
    }
  }
}
